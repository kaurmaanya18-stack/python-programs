tuition = float(input("Enter Tuition Fee: "))
lab = float(input("Enter Lab Fee: "))
library = float(input("Enter Library Fee: "))
exam = float(input("Enter Exam Fee: "))
discount = float(input("Enter Discount Amount: "))

total = tuition + lab + library + exam
after_discount = total - discount
annual = after_discount * 2
monthly = round(annual / 12, 2)

print("")
print("Tuition Fee: " + str(tuition))
print("Lab Fee: " + str(lab))
print("Library Fee: " + str(library))
print("Exam Fee: " + str(exam))
print("Total Fee: " + str(total))
print("Discount: " + str(discount))
print("Fee after Discount: " + str(after_discount))
print("Annual Fee: " + str(annual))
print("Monthly Installment: " + str(monthly))
